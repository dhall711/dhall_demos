# Snowflake Connection Configuration
# Copy this file to secrets.toml and update with your actual credentials

[connections.snowflake]
# Account identifier (required)
account = "your-account-identifier"  # e.g., "abc12345.us-east-1" or "myorg-myaccount"

# Authentication (choose one method)
user = "your-username"
password = "your-password"

# Alternative: OAuth authentication
# authenticator = "oauth"
# token = "your-oauth-token"

# Alternative: Key pair authentication
# authenticator = "snowflake"
# private_key_path = "/path/to/private_key.p8"
# private_key_passphrase = "your-passphrase"

# Alternative: External browser authentication
# authenticator = "externalbrowser"

# Connection details
database = "your-database"     # Default database
schema = "your-schema"         # Default schema
warehouse = "your-warehouse"   # Default warehouse for queries
role = "your-role"            # Role with account usage privileges

# Optional connection parameters
client_session_keep_alive = true
login_timeout = 60
network_timeout = 60

# Connection pool settings (optional)
# session_parameters = { "QUERY_TAG" = "multi_project_monitor" }

# Example for production setup
[connections.snowflake_prod]
account = "prod-account"
user = "monitoring_user"
password = "secure-password"
database = "MONITORING_DB"
schema = "USAGE_TRACKING"
warehouse = "MONITORING_WH"
role = "MONITORING_ROLE"
client_session_keep_alive = true

# Example for development/testing
[connections.snowflake_dev]
account = "dev-account"
user = "dev_user"
password = "dev-password"
database = "DEV_DB"
schema = "TESTING"
warehouse = "DEV_WH"
role = "DEV_ROLE" 